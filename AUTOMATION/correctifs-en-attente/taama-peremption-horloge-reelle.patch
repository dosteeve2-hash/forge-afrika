diff --git a/src/lib/peremption.ts b/src/lib/peremption.ts
new file mode 100644
index 0000000..a13fc20
--- /dev/null
+++ b/src/lib/peremption.ts
@@ -0,0 +1,50 @@
+'use client';
+
+import { useSyncExternalStore } from 'react';
+
+/**
+ * Minuit, heure locale, du jour contenant `ms`.
+ *
+ * On normalise au debut de journee pour que « il reste 1 jour » ne depende pas
+ * de l'heure a laquelle le magasinier ouvre l'ecran : sinon un lot expirant
+ * demain affiche 0 jour l'apres-midi et 1 jour le matin.
+ */
+export function debutDeJour(ms: number): number {
+  const d = new Date(ms);
+  d.setHours(0, 0, 0, 0);
+  return d.getTime();
+}
+
+/**
+ * Nombre de jours entiers entre `referenceMs` et une date d'expiration ISO.
+ * Negatif si le lot est deja perime.
+ */
+export function joursAvant(dateISO: string, referenceMs: number): number {
+  return Math.floor((new Date(dateISO).getTime() - debutDeJour(referenceMs)) / 86_400_000);
+}
+
+/**
+ * Le jour courant, lu APRES le montage.
+ *
+ * Cette page n'a aucune donnee dynamique : Next la prerend statiquement au
+ * build. Lire l'horloge pendant le rendu figerait donc la date du build dans
+ * le HTML servi — exactement le defaut que ce module corrige, avec une date
+ * plus recente. Le `null` initial est aussi ce qui garde le premier rendu
+ * identique cote serveur et cote client (meme pattern que `mounted` pour
+ * Recharts, cf. CLAUDE.md).
+ */
+function jamaisNotifie(): () => void {
+  return () => {};
+}
+
+export function useAujourdHui(): number | null {
+  return useSyncExternalStore(
+    jamaisNotifie,
+    // Cote client : stable toute la journee, donc une valeur que React peut
+    // comparer sans boucler.
+    () => debutDeJour(Date.now()),
+    // Cote serveur : aucun jour. Le premier rendu est donc identique des deux
+    // cotes, et aucune date de build ne se retrouve figee dans le HTML.
+    () => null,
+  );
+}
