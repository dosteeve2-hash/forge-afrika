+import { describe, it, expect, afterEach, vi } from 'vitest'
+import { debutDeJour, joursAvant } from '../src/lib/peremption'
+
+afterEach(() => { vi.useRealTimers() })
+
+describe('debutDeJour', () => {
+  it('ramene n\'importe quelle heure a minuit du meme jour', () => {
+    const matin = new Date('2026-10-03T06:12:00').getTime()
+    const soir  = new Date('2026-10-03T23:59:59').getTime()
+    expect(debutDeJour(matin)).toBe(debutDeJour(soir))
+  })
+
+  it('ne confond pas deux jours voisins', () => {
+    const avant = debutDeJour(new Date('2026-10-03T23:59:59').getTime())
+    const apres = debutDeJour(new Date('2026-10-04T00:00:01').getTime())
+    expect(apres - avant).toBe(86_400_000)
+  })
+})
+
+describe('joursAvant', () => {
+  const REFERENCE = new Date('2026-10-03T14:30:00').getTime()
+
+  it('compte les jours restants sans dependre de l\'heure de consultation', () => {
+    expect(joursAvant('2026-10-30', REFERENCE)).toBe(27)
+    expect(joursAvant('2026-10-30', new Date('2026-10-03T00:00:01').getTime())).toBe(27)
+  })
+
+  it('rend un nombre negatif pour un lot deja perime', () => {
+    expect(joursAvant('2026-09-01', REFERENCE)).toBe(-32)
+  })
+
+  it('rend 0 le jour meme de l\'expiration', () => {
+    expect(joursAvant('2026-10-03', REFERENCE)).toBe(0)
+  })
+
+  /**
+   * Le defaut corrige : la page portait `TODAY_MS = new Date('2026-08-08')`.
+   * Le Vaccin Hepatite B (expiration 2026-09-01) s'affichait donc « 24 j »
+   * pour toujours, y compris un mois apres sa peremption.
+   */
+  it('ne reste pas colle au 8 aout 2026', () => {
+    const geleAu8Aout = new Date('2026-08-08').getTime()
+    expect(joursAvant('2026-09-01', geleAu8Aout)).toBe(24)
+    expect(joursAvant('2026-09-01', new Date('2026-10-03').getTime())).toBe(-32)
+  })
+
+  it('suit l\'horloge du systeme, pas une constante du fichier', () => {
+    vi.useFakeTimers()
+    vi.setSystemTime(new Date('2027-01-01T09:00:00'))
+    expect(joursAvant('2026-09-01', Date.now())).toBeLessThan(0)
+    vi.setSystemTime(new Date('2026-08-01T09:00:00'))
+    expect(joursAvant('2026-09-01', Date.now())).toBeGreaterThan(0)
+  })
+})
